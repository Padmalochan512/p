# Application Settings
SECRET_KEY=your-secure-production-jwt-key-here-minimum-32-chars
PORT=8000
DATABASE_URL=sqlite:///./data/invoices_v2.db
MAX_FILE_SIZE_MB=10
DEFAULT_CURRENCY=INR
HIGH_VALUE_THRESHOLD=50000.0

# Optional AI LLM Vision API Keys
LLM_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llava

# Optional Webhook Alert URL (Slack, Discord, Custom)
WEBHOOK_ALERT_URL=
